
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAM ZONE"
            android:textColor="#E50914"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your entertainment. Your way."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPLORE"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/liveTvButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="LIVE TV"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B00020"
            android:focusable="true" />

        <Button
            android:id="@+id/channelsButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="24/7 CHANNELS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202020"
            android:focusable="true" />

        <Button
            android:id="@+id/moviesButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="MOVIES"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202020"
            android:focusable="true" />

        <Button
            android:id="@+id/seriesButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="TV SERIES"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202020"
            android:focusable="true" />

        <Button
            android:id="@+id/favoritesButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="MY FAVORITES"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202020"
            android:focusable="true" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="SETTINGS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#202020"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
